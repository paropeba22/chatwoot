<!DOCTYPE html>
<html>
  <head>
    <title>SuperAdmin | Grupo Telecom</title>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
  </head>
  <body>
    <div class="h-full w-full antialiased">
      <main class="flex flex-col min-h-screen w-full py-20 sm:px-6 lg:px-8 bg-[#0B0E14] bg-[radial-gradient(circle_at_center,rgba(0,82,255,0.1)_0%,transparent_50%)]">
        <section class="max-w-5xl mx-auto">
          <img src="/brand-assets/logo_dark.png" alt="Logo Grupo Telecom" class="mx-auto h-8 w-auto block">
          <h2 class="mt-6 text-center text-3xl font-medium text-white">
            Howdy, admin 👋
          </h2>
        </section>
        <section class="sm:mx-auto mt-11 sm:w-full sm:max-w-lg bg-[#0B0E14]/50 border border-[#24292F] backdrop-blur-sm p-11 sm:shadow-2xl sm:rounded-2xl mb-8 mt-15">
          <div>
            <%= form_for(resource, as: resource_name, url: '/super_admin/sign_in') do |f| %>
              <% if flash[:error].present? %>
                <div data-alert class="rounded-xl bg-red-500 p-4 text-white text-sm mb-5"><%= flash[:error] %></div>
              <% end %>
              <div class="mb-5">
                <label for="email_address" class="flex justify-between text-sm font-medium leading-6 text-white">
                Email Address
                </label>
                <div class="mt-1">
                  <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email eg: someone@example.com", class: "block w-full rounded-xl border-0 px-3 py-3 appearance-none shadow-sm ring-1 ring-inset text-white placeholder:text-slate-500 focus:ring-2 focus:ring-inset focus:ring-[#0052FF] sm:text-sm sm:leading-6 outline-none bg-black/20 ring-[#24292F]" %>
                </div>
              </div>
              <div class="mb-5">
                <label for="password" class="flex justify-between text-sm font-medium leading-6 text-white">
                  Password
                </label>
                <div class="mt-1">
                  <%= f.password_field :password, autocomplete: "current-password",  placeholder: "Password", class: "block w-full rounded-xl border-0 px-3 py-3 appearance-none shadow-sm ring-1 ring-inset text-white placeholder:text-slate-500 focus:ring-2 focus:ring-inset focus:ring-[#0052FF] sm:text-sm sm:leading-6 outline-none bg-black/20 ring-[#24292F]" %>
                </div>
              </div>
              <button type="submit" class="flex items-center w-full justify-center rounded-xl bg-[#0052FF] py-3 px-3 text-base font-medium text-white shadow-sm hover:bg-[#003dbf] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0052FF] cursor-pointer transition-colors duration-200">
                <span>Acessar Central de Comando</span>
              </button>
            <% end %>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
